# Copy to .env.local for local development. On Vercel, set these in Project Settings → Environment Variables.
# Without the three Supabase values the arcade runs games-only and every rewards screen stays hidden.

# Supabase project (Settings → API)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only. Never expose it to the browser or commit it.
SUPABASE_SERVICE_ROLE_KEY=

# Fixed in-store QR payloads, one per discount: scanning one applies that discount at the POS.
# Leave a value empty until the real one is provided: coupons can still be saved,
# but "Use in store" stays disabled for that discount and nothing is marked as used.
STORE_QR_VALUE_10=
STORE_QR_VALUE_15=
STORE_QR_VALUE_25=
STORE_QR_VALUE_30=
STORE_QR_VALUE_35=
# Only for coupons without a percentage, such as ones issued before discounts were set.
STORE_QR_VALUE=

# Any long random text. Keeps future Wordle answers from being worked out from the code.
# Changing it changes the answers, including today's.
WORDLE_SECRET=

# Optional: when the Wordle day rolls over.
# GAME_TIMEZONE=America/Los_Angeles
