# Copy to .env.local for local development. On Vercel, set these in Project Settings → Environment Variables.
# Without the three Supabase values the arcade runs games-only and every rewards screen stays hidden.

# Supabase project (Settings → API)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only. Never expose it to the browser or commit it.
SUPABASE_SERVICE_ROLE_KEY=

# The shared, fixed in-store QR payload (the same value for every customer).
# Leave empty until the real value is provided: coupons can still be saved,
# but "Use in store" stays disabled and nothing is marked as used.
STORE_QR_VALUE=

# Any long random text. Keeps future Wordle answers from being worked out from the code.
# Changing it changes the answers, including today's.
WORDLE_SECRET=

# Optional: when the Wordle day rolls over.
# GAME_TIMEZONE=America/Los_Angeles
